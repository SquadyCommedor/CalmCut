{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "nixpacksPlan": {
      "providers": ["node", "python"]
    }
  },
  "deploy": {
    "startCommand": "npm run build && npm run preview & python3 bridge.py",
    "restartPolicyType": "ON_FAILURE"
  }
}